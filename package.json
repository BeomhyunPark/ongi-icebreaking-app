{
  "name": "ongi-icebreaking-app",
  "private": true,
  "version": "2.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --testTimeout=20000 --maxWorkers=2",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:e2e": "tsc -b && vite build --outDir dist-e2e",
    "typecheck": "tsc -b",
    "load:anonymous-sharing": "node scripts/load/anonymous-sharing-load.mjs",
    "generate:share-images": "java -Djava.awt.headless=true scripts/GenerateShareImages.java",
    "build": "tsc -b && vite build",
    "verify": "npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
