#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
core="${HERDR_DEV_CORE:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/herdr-dev}"
[[ -x "$core" ]] || {
  printf '[ongi] ERROR: Herdr Dev core is not executable: %s\n' "$core" >&2
  exit 1
}
exec "$core" _run-tests "$root" "${1:-}" "${2:-manual-$(date +%Y%m%d-%H%M%S)}"
