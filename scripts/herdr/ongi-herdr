#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
REVIEW_TAB_LABEL="${ONGI_HERDR_REVIEW_TAB_LABEL:-REVIEW}"
REVIEW_PANE_LABEL="${ONGI_HERDR_REVIEW_PANE_LABEL:-REVIEW Codex}"
TEST_PANE_LABEL="${ONGI_HERDR_TEST_PANE_LABEL:-Test / Logs}"
REVIEWER_NAME="${ONGI_HERDR_REVIEWER_NAME:-ongi-reviewer}"
PROMPT_FILE="$SCRIPT_DIR/reviewer-prompt.txt"
WAIT_TIMEOUT_MS="${ONGI_HERDR_WAIT_TIMEOUT_MS:-900000}"
START_TIMEOUT_SECONDS="${ONGI_HERDR_START_TIMEOUT_SECONDS:-120}"
DEPLOY_TIMEOUT_SECONDS="${ONGI_HERDR_DEPLOY_TIMEOUT_SECONDS:-1800}"
DEPLOY_BRANCH="${ONGI_HERDR_DEPLOY_BRANCH:-master}"
FRONTEND_PRODUCTION_URL="${ONGI_HERDR_FRONTEND_PRODUCTION_URL:-https://ongi.greengroove.app/}"
BACKEND_PRODUCTION_HEALTH_URL="${ONGI_HERDR_BACKEND_PRODUCTION_HEALTH_URL:-https://ongi-api.greengroove.app/actuator/health/readiness}"

DEV_TAB_LABEL="${ONGI_HERDR_DEV_TAB_LABEL:-DEV}"
IMPLEMENT_PANE_LABEL="${ONGI_HERDR_IMPLEMENT_PANE_LABEL:-IMPLEMENT Codex}"
GIT_PANE_LABEL="${ONGI_HERDR_GIT_PANE_LABEL:-Git / Diff}"
FRONTEND_PANE_LABEL="${ONGI_HERDR_FRONTEND_PANE_LABEL:-Frontend Server}"
BACKEND_PANE_LABEL="${ONGI_HERDR_BACKEND_PANE_LABEL:-Backend Server}"
IMPLEMENTER_NAME="${ONGI_HERDR_IMPLEMENTER_NAME:-ongi-implementer}"
FRONTEND_URL="${ONGI_HERDR_FRONTEND_URL:-http://localhost:5173}"
BACKEND_HEALTH_URL="${ONGI_HERDR_BACKEND_HEALTH_URL:-http://localhost:8080/actuator/health}"
DEV_RUNNER="$SCRIPT_DIR/run-dev-service"
STATE_DIR="$PROJECT_ROOT/.herdr/logs"

REVIEW_TAB_ID=""
REVIEW_PANE_ID=""
TEST_PANE_ID=""
REVIEWER_TARGET=""
DEV_TAB_ID=""
IMPLEMENT_PANE_ID=""
GIT_PANE_ID=""
FRONTEND_PANE_ID=""
BACKEND_PANE_ID=""
IMPLEMENTER_TARGET=""
REVIEW_OUTPUT=""
REVIEW_VERDICT=""
ACTIONS_TRACKED=0

usage() {
  cat <<'EOF'
Usage: scripts/herdr/ongi-herdr <command> [options]

Commands:
  doctor             Check local prerequisites (works outside Herdr)
  dev                Prepare DEV + REVIEW and start Codex, DB, and both servers
  stop               Stop only frontend/backend processes started by this script
  restart            Stop managed frontend/backend processes, then run dev
  setup              Ensure REVIEW tab, reviewer Codex, and Test / Logs pane
  review             Review the current git diff and print the reviewer output
  test [profile]     Run tests in Test / Logs (prompts when profile is omitted)
  all [profile]      Start tests and review together, then print both results
  ship [--yes]       Verify, review, commit, push, deploy, and check production
  ship --dry-run     Check the release preflight without changing git or remote
  deploy-status      Show the latest deploy run and production health
  status             Show the managed tab, panes, and reviewer state
  results            Print recent reviewer and test output
  dev-layout         Create/identify the DEV tab and its four named panes only

Test profiles: frontend, verify, backend, e2e, full
EOF
}

fail() {
  printf '[ongi-herdr] ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1"
}

require_herdr_context() {
  if [[ "${HERDR_ENV:-}" != "1" ]]; then
    fail "Run this command inside a Herdr-managed pane (HERDR_ENV=1)."
  fi
  [[ -n "${HERDR_WORKSPACE_ID:-}" ]] || fail "HERDR_WORKSPACE_ID is not set."
}

jq_value() {
  local json="$1"
  local filter="$2"
  jq -er "$filter // empty" <<<"$json" 2>/dev/null || true
}

first_pane_in_tab() {
  local panes_json="$1"
  local tab_id="$2"
  jq -r --arg tab "$tab_id" \
    '[.result.panes[]? | select(.tab_id == $tab)][0].pane_id // empty' <<<"$panes_json"
}

find_pane_by_label() {
  local panes_json="$1"
  local tab_id="$2"
  local label="$3"
  jq -r --arg tab "$tab_id" --arg label "$label" \
    '[.result.panes[]? | select(.tab_id == $tab and .label == $label)][0].pane_id // empty' <<<"$panes_json"
}

ensure_review_layout() {
  local tabs_json create_json panes_json anchor split_json

  tabs_json="$(herdr tab list --workspace "$HERDR_WORKSPACE_ID")"
  REVIEW_TAB_ID="$(jq -r --arg label "$REVIEW_TAB_LABEL" \
    '[.result.tabs[]? | select(.label == $label)][0].tab_id // empty' <<<"$tabs_json")"

  if [[ -z "$REVIEW_TAB_ID" ]]; then
    create_json="$(herdr tab create \
      --workspace "$HERDR_WORKSPACE_ID" \
      --cwd "$PROJECT_ROOT" \
      --label "$REVIEW_TAB_LABEL" \
      --no-focus)"
    REVIEW_TAB_ID="$(jq_value "$create_json" '.result.tab.tab_id')"
    REVIEW_PANE_ID="$(jq_value "$create_json" '.result.root_pane.pane_id')"
    [[ -n "$REVIEW_TAB_ID" && -n "$REVIEW_PANE_ID" ]] || \
      fail "Could not read the REVIEW tab or pane ID from Herdr."
    herdr pane rename "$REVIEW_PANE_ID" "$REVIEW_PANE_LABEL" >/dev/null
  fi

  panes_json="$(herdr pane list --workspace "$HERDR_WORKSPACE_ID")"
  if [[ -z "$REVIEW_PANE_ID" ]]; then
    REVIEW_PANE_ID="$(find_pane_by_label "$panes_json" "$REVIEW_TAB_ID" "$REVIEW_PANE_LABEL")"
  fi

  if [[ -z "$REVIEW_PANE_ID" ]]; then
    anchor="$(first_pane_in_tab "$panes_json" "$REVIEW_TAB_ID")"
    [[ -n "$anchor" ]] || fail "The REVIEW tab has no pane to reuse or split."

    if [[ "$(jq -r --arg tab "$REVIEW_TAB_ID" \
      '[.result.panes[]? | select(.tab_id == $tab)] | length' <<<"$panes_json")" == "1" ]]; then
      REVIEW_PANE_ID="$anchor"
    else
      split_json="$(herdr pane split "$anchor" --direction right --ratio 0.55 \
        --cwd "$PROJECT_ROOT" --no-focus)"
      REVIEW_PANE_ID="$(jq_value "$split_json" '.result.pane.pane_id')"
    fi
    [[ -n "$REVIEW_PANE_ID" ]] || fail "Could not create the reviewer pane."
    herdr pane rename "$REVIEW_PANE_ID" "$REVIEW_PANE_LABEL" >/dev/null
  fi

  panes_json="$(herdr pane list --workspace "$HERDR_WORKSPACE_ID")"
  TEST_PANE_ID="$(find_pane_by_label "$panes_json" "$REVIEW_TAB_ID" "$TEST_PANE_LABEL")"
  if [[ -z "$TEST_PANE_ID" ]]; then
    split_json="$(herdr pane split "$REVIEW_PANE_ID" --direction down --ratio 0.40 \
      --cwd "$PROJECT_ROOT" --no-focus)"
    TEST_PANE_ID="$(jq_value "$split_json" '.result.pane.pane_id')"
    [[ -n "$TEST_PANE_ID" ]] || fail "Could not create the Test / Logs pane."
    herdr pane rename "$TEST_PANE_ID" "$TEST_PANE_LABEL" >/dev/null
  fi
}

ensure_reviewer() {
  local agents_json named_pane pane_agent_name pane_agent_kind start_json

  agents_json="$(herdr agent list)"
  named_pane="$(jq -r --arg name "$REVIEWER_NAME" \
    '[.result.agents[]? | select(.name == $name)][0].pane_id // empty' <<<"$agents_json")"
  if [[ -n "$named_pane" ]]; then
    REVIEW_PANE_ID="$named_pane"
    REVIEWER_TARGET="$REVIEWER_NAME"
    return
  fi

  pane_agent_name="$(jq -r --arg pane "$REVIEW_PANE_ID" \
    '[.result.agents[]? | select(.pane_id == $pane)][0].name // empty' <<<"$agents_json")"
  pane_agent_kind="$(jq -r --arg pane "$REVIEW_PANE_ID" \
    '[.result.agents[]? | select(.pane_id == $pane)][0].agent // empty' <<<"$agents_json")"

  if [[ -n "$pane_agent_name" && "$pane_agent_kind" == "codex" ]]; then
    REVIEWER_TARGET="$pane_agent_name"
    return
  fi

  if [[ -n "$pane_agent_kind" ]]; then
    fail "Pane $REVIEW_PANE_ID already contains a non-Codex agent ($pane_agent_kind)."
  fi

  start_json="$(herdr agent start "$REVIEWER_NAME" --kind codex \
    --pane "$REVIEW_PANE_ID" --timeout 120000)"
  [[ -n "$(jq_value "$start_json" '.result.agent.pane_id')" ]] || \
    fail "Herdr did not confirm that reviewer Codex started."
  REVIEWER_TARGET="$REVIEWER_NAME"
}

setup() {
  require_herdr_context
  require_command herdr
  require_command jq
  require_command codex
  ensure_review_layout
  ensure_reviewer
  printf '[ongi-herdr] REVIEW ready\n'
  printf '  tab:      %s (%s)\n' "$REVIEW_TAB_LABEL" "$REVIEW_TAB_ID"
  printf '  reviewer: %s (%s)\n' "$REVIEWER_TARGET" "$REVIEW_PANE_ID"
  printf '  tests:    %s (%s)\n' "$TEST_PANE_LABEL" "$TEST_PANE_ID"
}

choose_profile() {
  local choice
  printf 'Choose a test profile:\n' >&2
  printf '  1) frontend  - Vitest\n' >&2
  printf '  2) verify    - frontend tests + production build\n' >&2
  printf '  3) backend   - Gradle tests (Docker required)\n' >&2
  printf '  4) e2e       - Playwright tests\n' >&2
  printf '  5) full      - verify + backend tests\n' >&2
  read -r -p '> ' choice
  case "$choice" in
    1|frontend) printf 'frontend\n' ;;
    2|verify) printf 'verify\n' ;;
    3|backend) printf 'backend\n' ;;
    4|e2e) printf 'e2e\n' ;;
    5|full) printf 'full\n' ;;
    *) fail "Unknown test profile: $choice" ;;
  esac
}

validate_profile() {
  case "$1" in
    frontend|verify|backend|e2e|full) ;;
    *) fail "Unknown test profile '$1'. Use: frontend, verify, backend, e2e, full." ;;
  esac
}

start_tests() {
  local profile="$1"
  local run_id="$2"
  local command

  validate_profile "$profile"
  command="bash scripts/herdr/run-tests \"$profile\" \"$run_id\""
  herdr pane run "$TEST_PANE_ID" "$command" >/dev/null
  printf '[ongi-herdr] Started %s tests in %s (%s)\n' \
    "$profile" "$TEST_PANE_LABEL" "$TEST_PANE_ID"
}

wait_for_tests() {
  local run_id="$1"
  local marker="[ongi-herdr:$run_id] finished"
  herdr pane wait-output "$TEST_PANE_ID" \
    --match "$marker" \
    --source recent-unwrapped \
    --lines 300 \
    --timeout "$WAIT_TIMEOUT_MS" >/dev/null
}

print_test_results() {
  printf '\n===== TEST / LOGS =====\n'
  herdr pane read "$TEST_PANE_ID" --source recent-unwrapped --lines 160
  printf '\nLatest persistent log: %s/.herdr/logs/latest.log\n' "$PROJECT_ROOT"
}

run_review() {
  local prompt verdict review_token marker
  [[ -f "$PROMPT_FILE" ]] || fail "Missing reviewer prompt: $PROMPT_FILE"
  prompt="$(<"$PROMPT_FILE")"
  review_token="$(date +%Y%m%d%H%M%S)-$$"
  marker="REVIEW_RESULT_${review_token}:"
  prompt+=$'\n'
  prompt+="이번 리뷰의 마지막 줄은 중요 이슈가 없으면 정확히 '$marker PASS', 하나라도 있으면 정확히 '$marker FAIL'로 출력해."
  printf '[ongi-herdr] Asking %s to review the current diff...\n' "$REVIEWER_TARGET"
  herdr agent prompt "$REVIEWER_TARGET" "$prompt" \
    --wait --timeout "$WAIT_TIMEOUT_MS" >/dev/null
  printf '\n===== REVIEW =====\n'
  REVIEW_OUTPUT="$(herdr agent read "$REVIEWER_TARGET" --source recent-unwrapped --lines 200)"
  printf '%s\n' "$REVIEW_OUTPUT"
  verdict="$(awk -v marker="$marker" '$1 == marker && ($2 == "PASS" || $2 == "FAIL") { verdict=$2 } END { print verdict }' <<<"$REVIEW_OUTPUT")"
  REVIEW_VERDICT="$verdict"
}

check_run_result() {
  local run_id="$1"
  local status_file="$STATE_DIR/$run_id-status.log"
  [[ -f "$status_file" ]] || fail "Test result file is missing: $status_file"
  local status
  status="$(<"$status_file")"
  [[ "$status" == "0" ]] || fail "Tests failed (exit $status). Deployment was stopped."
  [[ "$REVIEW_VERDICT" == "PASS" ]] || {
    if [[ "$REVIEW_VERDICT" == "FAIL" ]]; then
      fail "Reviewer found an important issue. Deployment was stopped."
    fi
    fail "Reviewer did not return a machine-readable verdict. Deployment was stopped safely."
  }
}

run_all() {
  local profile="${1:-verify}"
  local run_id
  setup
  run_id="$(date +%Y%m%d-%H%M%S)-$$"
  start_tests "$profile" "$run_id"
  run_review
  printf '[ongi-herdr] Waiting for test completion...\n'
  wait_for_tests "$run_id"
  print_test_results
  check_run_result "$run_id"
  printf '[ongi-herdr] Tests and review passed\n'
}

git_tree_snapshot() {
  local temporary_root temporary_index temporary_objects existing_objects tree
  temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/ongi-herdr-snapshot.XXXXXX")"
  temporary_index="$temporary_root/index"
  temporary_objects="$temporary_root/objects"
  existing_objects="$(git rev-parse --absolute-git-dir)/objects"
  mkdir "$temporary_objects"
  if ! GIT_INDEX_FILE="$temporary_index" \
       GIT_OBJECT_DIRECTORY="$temporary_objects" \
       GIT_ALTERNATE_OBJECT_DIRECTORIES="$existing_objects" \
       git read-tree HEAD; then
    rm -rf -- "$temporary_root"
    fail "Could not prepare the reviewed git snapshot."
  fi
  if ! GIT_INDEX_FILE="$temporary_index" \
       GIT_OBJECT_DIRECTORY="$temporary_objects" \
       GIT_ALTERNATE_OBJECT_DIRECTORIES="$existing_objects" \
       git add -A; then
    rm -rf -- "$temporary_root"
    fail "Could not snapshot all working tree changes."
  fi
  tree="$(GIT_INDEX_FILE="$temporary_index" \
    GIT_OBJECT_DIRECTORY="$temporary_objects" \
    GIT_ALTERNATE_OBJECT_DIRECTORIES="$existing_objects" \
    git write-tree)" || {
      rm -rf -- "$temporary_root"
      fail "Could not finalize the reviewed git snapshot."
    }
  rm -rf -- "$temporary_root"
  printf '%s\n' "$tree"
}

require_clean_git_state_for_ship() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "Not inside a git repository."
  git diff --check || fail "Whitespace errors or conflict markers were found."
  [[ -z "$(git ls-files -u)" ]] || fail "Unresolved merge conflicts exist."
  [[ -n "$(git status --porcelain)" ]] || fail "There are no changes to ship."
}

current_repository() {
  local url
  url="$(git remote get-url origin 2>/dev/null || true)"
  sed -E 's#^git@github.com:#https://github.com/#; s#\.git$##' <<<"$url"
}

github_cli_ready() {
  command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1
}

check_deploy_branch_policy() {
  local branch="$1"
  local repository rules
  [[ "$branch" == "$DEPLOY_BRANCH" ]] || \
    fail "'$branch' is not the production branch '$DEPLOY_BRANCH'. Merge or switch first; no push was attempted."

  repository="$(current_repository)"
  [[ "$repository" == https://github.com/*/* ]] || fail "origin is not a supported GitHub repository: $repository"

  if github_cli_ready; then
    rules="$(gh api "repos/${repository#https://github.com/}/rules/branches/$branch" 2>/dev/null || true)"
    if [[ -n "$rules" ]] && jq -e \
      '[.[]? | select(.enforcement == "active") | .rules[]? | select(.type == "pull_request")] | length > 0' \
      <<<"$rules" >/dev/null; then
      fail "GitHub rules require a pull request for '$branch'; direct ship is blocked."
    fi
  elif [[ ! -f "$PROJECT_ROOT/.github/workflows/pages.yml" ]] || \
       ! grep -Eq 'branches:[[:space:]]*\[master\]' "$PROJECT_ROOT/.github/workflows/pages.yml"; then
    fail "Could not verify that direct '$branch' pushes are the repository deployment policy."
  fi
}

require_branch_synced_with_origin() {
  local branch="$1"
  local ahead behind
  git fetch --quiet origin "$branch" || fail "Could not refresh origin/$branch; nothing was committed."
  git rev-parse --verify "refs/remotes/origin/$branch" >/dev/null 2>&1 || \
    fail "origin/$branch does not exist."
  read -r ahead behind < <(git rev-list --left-right --count "HEAD...refs/remotes/origin/$branch")
  [[ "$behind" == "0" ]] || \
    fail "Local '$branch' is behind origin by $behind commit(s). Update it before shipping."
  [[ "$ahead" == "0" ]] || \
    fail "Local '$branch' already has $ahead unpushed commit(s). Push or reconcile them before shipping so review scope stays exact."
}

default_commit_message() {
  local changed
  changed="$(git status --porcelain)"
  if grep -Eq '(^| )((src|backend)/)' <<<"$changed"; then
    printf 'feat: 온기 기능 변경사항 반영\n'
  elif grep -Eq '(^| )(tests/|e2e/)' <<<"$changed"; then
    printf 'test: 온기 검증 시나리오 보강\n'
  elif grep -Eq '(^| )(docs/|README)' <<<"$changed" && \
       ! grep -Eq '(^| )(.github/|scripts/)' <<<"$changed"; then
    printf 'docs: 온기 문서 최신화\n'
  else
    printf 'chore: 온기 자동화 및 설정 정비\n'
  fi
}

generate_commit_message() {
  local fallback prompt output message message_token marker
  local conventional_pattern='^(feat|fix|docs|test|refactor|chore|build|ci|perf|style)(\([^)]*\))?:[[:space:]].+'
  fallback="$(default_commit_message)"
  [[ -n "$REVIEWER_TARGET" ]] || { printf '%s\n' "$fallback"; return; }
  message_token="$(date +%Y%m%d%H%M%S)-$$"
  marker="COMMIT_MESSAGE_${message_token}:"
  prompt="현재 git 변경사항을 요약하는 커밋 제목 한 줄만 만들어줘. 기존 Conventional Commit 형식(type: 제목)을 따르고 제목은 한국어로 써. 코드 식별자는 영어여도 돼. 다른 설명 없이 '$marker '로 시작해."
  if herdr agent prompt "$REVIEWER_TARGET" "$prompt" --wait --timeout "$WAIT_TIMEOUT_MS" >/dev/null 2>&1; then
    output="$(herdr agent read "$REVIEWER_TARGET" --source recent-unwrapped --lines 40)"
    message="$(awk -v marker="$marker" 'index($0, marker " ") == 1 { message=substr($0, length(marker) + 2) } END { print message }' <<<"$output")"
    if [[ "$message" =~ $conventional_pattern ]]; then
      printf '%s\n' "$message"
      return
    fi
  fi
  printf '%s\n' "$fallback"
}

print_change_summary() {
  printf '\n===== CHANGES TO SHIP =====\n'
  git status --short
  printf '\n'
  git diff --stat HEAD
}

wait_for_actions_run() {
  local sha="$1"
  local repository_slug="$2"
  local elapsed=0 run_id run_url status conclusion
  if ! github_cli_ready; then
    printf '[ongi-herdr] GitHub CLI is unavailable or unauthenticated; follow Actions manually:\n'
    printf '  https://github.com/%s/actions/workflows/pages.yml\n' "$repository_slug"
    return 0
  fi
  printf '[ongi-herdr] Waiting for the GitHub Actions run...\n'
  while (( elapsed < 90 )); do
    run_id="$(gh run list --repo "$repository_slug" --workflow pages.yml --commit "$sha" \
      --json databaseId --jq '.[0].databaseId // empty' 2>/dev/null || true)"
    [[ -n "$run_id" ]] && break
    sleep 3
    elapsed=$((elapsed + 3))
  done
  [[ -n "$run_id" ]] || fail "Push succeeded, but its GitHub Actions run was not found. Check the Actions page."
  run_url="$(gh run view "$run_id" --repo "$repository_slug" --json url --jq .url)"
  printf '  %s\n' "$run_url"
  while (( elapsed < DEPLOY_TIMEOUT_SECONDS )); do
    read -r status conclusion < <(gh run view "$run_id" --repo "$repository_slug" \
      --json status,conclusion --jq '[.status, (.conclusion // "pending")] | @tsv')
    if [[ "$status" == "completed" ]]; then
      [[ "$conclusion" == "success" ]] || fail "GitHub Actions deployment failed ($conclusion): $run_url"
      ACTIONS_TRACKED=1
      printf '[ongi-herdr] GitHub Actions deployment succeeded\n'
      return
    fi
    printf '[ongi-herdr] Actions status: %s\n' "$status"
    sleep 10
    elapsed=$((elapsed + 10))
  done
  fail "Timed out waiting for GitHub Actions after ${DEPLOY_TIMEOUT_SECONDS}s: $run_url"
}

check_production_health() {
  local failed=0
  printf '\n===== PRODUCTION HEALTH =====\n'
  if curl --fail --silent --show-error --max-time 15 "$FRONTEND_PRODUCTION_URL" >/dev/null; then
    printf 'Frontend: OK  %s\n' "$FRONTEND_PRODUCTION_URL"
  else
    printf 'Frontend: FAIL  %s\n' "$FRONTEND_PRODUCTION_URL" >&2
    failed=1
  fi
  if curl --fail --silent --show-error --max-time 15 "$BACKEND_PRODUCTION_HEALTH_URL" >/dev/null; then
    printf 'Backend:  OK  %s\n' "$BACKEND_PRODUCTION_HEALTH_URL"
  else
    printf 'Backend:  FAIL  %s\n' "$BACKEND_PRODUCTION_HEALTH_URL" >&2
    failed=1
  fi
  [[ "$failed" -eq 0 ]] || fail "Deployment was triggered, but a production health check failed."
}

show_deploy_status() {
  local repository repository_slug
  require_command git
  require_command curl
  repository="$(current_repository)"
  repository_slug="${repository#https://github.com/}"
  printf 'Repository: %s\n' "$repository"
  if github_cli_ready; then
    gh run list --repo "$repository_slug" --workflow pages.yml --branch "$DEPLOY_BRANCH" --limit 1
  else
    printf 'GitHub Actions: https://github.com/%s/actions/workflows/pages.yml\n' "$repository_slug"
    printf 'Note: run details unavailable until `gh auth login -h github.com` succeeds.\n'
  fi
  check_production_health
}

ship() {
  local assume_yes=0 dry_run=0 argument branch before_snapshot after_snapshot message repository_slug sha
  shift
  for argument in "$@"; do
    case "$argument" in
      --yes) assume_yes=1 ;;
      --dry-run) dry_run=1 ;;
      *) fail "Unknown ship option: $argument" ;;
    esac
  done

  require_command git
  require_command curl
  require_command jq
  cd "$PROJECT_ROOT"
  require_clean_git_state_for_ship
  branch="$(git branch --show-current)"
  [[ -n "$branch" ]] || fail "Detached HEAD cannot be shipped."
  check_deploy_branch_policy "$branch"

  if [[ "$dry_run" -eq 1 ]]; then
    print_change_summary
    printf '\n[ongi-herdr] DRY RUN: would run all -> approve once -> commit -> push -> watch deploy -> health check\n'
    printf 'Branch: %s\nCommit fallback: %s\n' "$branch" "$(default_commit_message)"
    return
  fi

  require_branch_synced_with_origin "$branch"
  before_snapshot="$(git_tree_snapshot)"
  run_all full
  after_snapshot="$(git_tree_snapshot)"
  [[ "$before_snapshot" == "$after_snapshot" ]] || \
    fail "Working tree changed during verification. Review the new changes and run ship again."
  print_change_summary
  message="$(generate_commit_message)"
  printf 'Branch: %s\nCommit: %s\n' "$branch" "$message"

  if [[ "$assume_yes" -ne 1 ]]; then
    local answer
    if ! read -r -p 'Commit, push, and deploy these changes? [y/N] ' answer; then
      fail "Confirmation requires an interactive terminal; use --yes only when intentionally bypassing it."
    fi
    [[ "$answer" == "y" || "$answer" == "Y" ]] || fail "Cancelled before commit; nothing was pushed or deployed."
  fi

  git add -A
  [[ "$(git write-tree)" == "$after_snapshot" ]] || fail "Staged tree differs from the reviewed tree. Commit was stopped."
  git commit -m "$message"
  sha="$(git rev-parse HEAD)"
  git push origin "HEAD:$branch" || fail "Commit succeeded locally, but push failed. Fix the issue and rerun ship."
  repository_slug="$(current_repository)"
  repository_slug="${repository_slug#https://github.com/}"
  wait_for_actions_run "$sha" "$repository_slug"
  check_production_health
  if [[ "$ACTIONS_TRACKED" -eq 1 ]]; then
    printf '\n[ongi-herdr] SHIP SUCCESS %s\n' "$sha"
  else
    printf '\n[ongi-herdr] SHIP PUSHED %s\n' "$sha"
    printf '[ongi-herdr] Deployment tracking was unavailable; verify the Actions URL above before treating it as complete.\n'
  fi
}

show_results() {
  setup >/dev/null
  printf '===== REVIEW =====\n'
  herdr agent read "$REVIEWER_TARGET" --source recent-unwrapped --lines 200
  print_test_results
}

show_status() {
  setup >/dev/null
  dev_layout >/dev/null
  local agent_json implementer_json ensure_implementer_status frontend_pid backend_pid
  agent_json="$(herdr agent get "$REVIEWER_TARGET")"
  printf 'Herdr %s | workspace %s\n' "$(herdr --version | awk '{print $2}')" "$HERDR_WORKSPACE_ID"
  printf 'DEV tab:       %s\n' "$DEV_TAB_ID"
  printf 'Implementer:   '
  if ensure_implementer_status="$(herdr agent get "$IMPLEMENTER_NAME" 2>/dev/null)"; then
    implementer_json="$ensure_implementer_status"
    printf '%s (%s)\n' "$IMPLEMENTER_NAME" \
      "$(jq -r '.result.agent.agent_status // "unknown"' <<<"$implementer_json")"
  else
    printf 'not running\n'
  fi
  if frontend_pid="$(managed_service_pid frontend "$FRONTEND_PANE_ID")"; then
    printf 'Frontend:      managed pid %s%s\n' "$frontend_pid" \
      "$(url_is_ready "$FRONTEND_URL" && printf ' (ready)' || printf ' (starting/unhealthy)')"
  elif url_is_ready "$FRONTEND_URL"; then
    printf 'Frontend:      reachable, external/unmanaged\n'
  else
    printf 'Frontend:      stopped\n'
  fi
  if backend_pid="$(managed_service_pid backend "$BACKEND_PANE_ID")"; then
    printf 'Backend:       managed pid %s%s\n' "$backend_pid" \
      "$(url_is_ready "$BACKEND_HEALTH_URL" && printf ' (ready)' || printf ' (starting/unhealthy)')"
  elif url_is_ready "$BACKEND_HEALTH_URL"; then
    printf 'Backend:       reachable, external/unmanaged\n'
  else
    printf 'Backend:       stopped\n'
  fi
  printf 'REVIEW tab:    %s\n' "$REVIEW_TAB_ID"
  printf 'Reviewer pane: %s\n' "$REVIEW_PANE_ID"
  printf 'Reviewer:      %s (%s)\n' "$REVIEWER_TARGET" \
    "$(jq -r '.result.agent.agent_status // "unknown"' <<<"$agent_json")"
  printf 'Test pane:     %s\n' "$TEST_PANE_ID"
}

ensure_named_pane() {
  local tab_id="$1"
  local label="$2"
  local anchor="$3"
  local direction="$4"
  local panes_json pane_id split_json
  panes_json="$(herdr pane list --workspace "$HERDR_WORKSPACE_ID")"
  pane_id="$(find_pane_by_label "$panes_json" "$tab_id" "$label")"
  if [[ -z "$pane_id" ]]; then
    split_json="$(herdr pane split "$anchor" --direction "$direction" --ratio 0.50 \
      --cwd "$PROJECT_ROOT" --no-focus)"
    pane_id="$(jq_value "$split_json" '.result.pane.pane_id')"
    [[ -n "$pane_id" ]] || fail "Could not create pane: $label"
    herdr pane rename "$pane_id" "$label" >/dev/null
  fi
  printf '%s\n' "$pane_id"
}

dev_layout() {
  require_herdr_context
  require_command herdr
  require_command jq

  local tabs_json create_json panes_json anchor seed split_json
  tabs_json="$(herdr tab list --workspace "$HERDR_WORKSPACE_ID")"
  DEV_TAB_ID="$(jq -r --arg label "$DEV_TAB_LABEL" \
    '[.result.tabs[]? | select(.label == $label)][0].tab_id // empty' <<<"$tabs_json")"
  if [[ -z "$DEV_TAB_ID" ]]; then
    create_json="$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" \
      --cwd "$PROJECT_ROOT" --label "$DEV_TAB_LABEL" --no-focus)"
    DEV_TAB_ID="$(jq_value "$create_json" '.result.tab.tab_id')"
    anchor="$(jq_value "$create_json" '.result.root_pane.pane_id')"
    [[ -n "$DEV_TAB_ID" && -n "$anchor" ]] || fail "Could not read the DEV tab or pane ID from Herdr."
    herdr pane rename "$anchor" "$GIT_PANE_LABEL" >/dev/null
  else
    panes_json="$(herdr pane list --workspace "$HERDR_WORKSPACE_ID")"
    anchor="$(find_pane_by_label "$panes_json" "$DEV_TAB_ID" "$GIT_PANE_LABEL")"
    if [[ -z "$anchor" ]]; then
      anchor="$(jq -r --arg tab "$DEV_TAB_ID" \
        '[.result.panes[]? | select(.tab_id == $tab and (.agent == null or .agent == "") and (.label == null or .label == ""))][0].pane_id // empty' \
        <<<"$panes_json")"
    fi
    if [[ -z "$anchor" ]]; then
      seed="$(first_pane_in_tab "$panes_json" "$DEV_TAB_ID")"
      [[ -n "$seed" ]] || fail "The DEV tab has no pane."
      split_json="$(herdr pane split "$seed" --direction right --ratio 0.50 \
        --cwd "$PROJECT_ROOT" --no-focus)"
      anchor="$(jq_value "$split_json" '.result.pane.pane_id')"
      [[ -n "$anchor" ]] || fail "Could not create the Git / Diff pane."
    fi
    if [[ "$(jq -r --arg pane "$anchor" \
      '[.result.panes[]? | select(.pane_id == $pane)][0].label // empty' <<<"$panes_json")" != "$GIT_PANE_LABEL" ]]; then
      herdr pane rename "$anchor" "$GIT_PANE_LABEL" >/dev/null
    fi
  fi

  GIT_PANE_ID="$anchor"
  IMPLEMENT_PANE_ID="$(ensure_named_pane "$DEV_TAB_ID" "$IMPLEMENT_PANE_LABEL" "$GIT_PANE_ID" right)"
  FRONTEND_PANE_ID="$(ensure_named_pane "$DEV_TAB_ID" "$FRONTEND_PANE_LABEL" "$GIT_PANE_ID" down)"
  BACKEND_PANE_ID="$(ensure_named_pane "$DEV_TAB_ID" "$BACKEND_PANE_LABEL" "$IMPLEMENT_PANE_ID" down)"

  printf '[ongi-herdr] DEV layout ready (servers are not started)\n'
  printf '  %s: %s\n' "$GIT_PANE_LABEL" "$GIT_PANE_ID"
  printf '  %s: %s\n' "$IMPLEMENT_PANE_LABEL" "$IMPLEMENT_PANE_ID"
  printf '  %s: %s\n' "$FRONTEND_PANE_LABEL" "$FRONTEND_PANE_ID"
  printf '  %s: %s\n' "$BACKEND_PANE_LABEL" "$BACKEND_PANE_ID"
  printf 'Start the implementer with:\n'
  printf '  herdr agent start %s --kind codex --pane %s\n' "$IMPLEMENTER_NAME" "$IMPLEMENT_PANE_ID"
}

ensure_implementer() {
  local agents_json named_pane pane_agent_name pane_agent_kind start_json

  agents_json="$(herdr agent list)"
  named_pane="$(jq -r --arg name "$IMPLEMENTER_NAME" \
    '[.result.agents[]? | select(.name == $name)][0].pane_id // empty' <<<"$agents_json")"
  if [[ -n "$named_pane" ]]; then
    IMPLEMENT_PANE_ID="$named_pane"
    IMPLEMENTER_TARGET="$IMPLEMENTER_NAME"
    return
  fi

  pane_agent_name="$(jq -r --arg pane "$IMPLEMENT_PANE_ID" \
    '[.result.agents[]? | select(.pane_id == $pane)][0].name // empty' <<<"$agents_json")"
  pane_agent_kind="$(jq -r --arg pane "$IMPLEMENT_PANE_ID" \
    '[.result.agents[]? | select(.pane_id == $pane)][0].agent // empty' <<<"$agents_json")"

  if [[ -n "$pane_agent_name" && "$pane_agent_kind" == "codex" ]]; then
    IMPLEMENTER_TARGET="$pane_agent_name"
    return
  fi
  if [[ -n "$pane_agent_kind" ]]; then
    fail "IMPLEMENT pane already contains a non-Codex agent ($pane_agent_kind)."
  fi

  printf '[ongi-herdr] Starting IMPLEMENT Codex...\n'
  start_json="$(herdr agent start "$IMPLEMENTER_NAME" --kind codex \
    --pane "$IMPLEMENT_PANE_ID" --timeout 120000)"
  [[ -n "$(jq_value "$start_json" '.result.agent.pane_id')" ]] || \
    fail "Herdr did not confirm that IMPLEMENT Codex started."
  IMPLEMENTER_TARGET="$IMPLEMENTER_NAME"
}

state_file() {
  printf '%s/dev-%s.pid.log\n' "$STATE_DIR" "$1"
}

managed_service_pid() {
  local service="$1"
  local expected_pane="$2"
  local file pid pane
  file="$(state_file "$service")"
  [[ -f "$file" ]] || return 1
  read -r pid pane <"$file" || return 1
  [[ "$pid" =~ ^[0-9]+$ && "$pane" == "$expected_pane" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

url_is_ready() {
  curl --fail --silent --show-error --max-time 2 "$1" >/dev/null 2>&1
}

wait_for_url() {
  local label="$1"
  local url="$2"
  local elapsed=0
  while (( elapsed < START_TIMEOUT_SECONDS )); do
    if url_is_ready "$url"; then
      printf '[ongi-herdr] %s ready: %s\n' "$label" "$url"
      return
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  fail "$label did not become ready within ${START_TIMEOUT_SECONDS}s. Check its pane output."
}

ensure_database() {
  require_command docker
  docker compose version >/dev/null 2>&1 || fail "Docker Compose is unavailable."
  printf '[ongi-herdr] Starting PostgreSQL if needed...\n'
  docker compose up -d postgres || fail "Database step failed: docker compose could not start postgres."

  local attempt
  for attempt in {1..30}; do
    if docker compose exec -T postgres sh -c \
      'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"' >/dev/null 2>&1; then
      printf '[ongi-herdr] PostgreSQL ready\n'
      return
    fi
    sleep 1
  done
  fail "Database step failed: postgres did not become ready within 30s."
}

start_dev_service() {
  local service="$1"
  local label="$2"
  local pane_id="$3"
  local url="$4"
  local pid

  if url_is_ready "$url"; then
    printf '[ongi-herdr] %s already reachable; leaving the existing process unchanged.\n' "$label"
    return
  fi
  if pid="$(managed_service_pid "$service" "$pane_id")"; then
    printf '[ongi-herdr] %s is already starting (pid %s).\n' "$label" "$pid"
    wait_for_url "$label" "$url"
    return
  fi

  [[ -f "$DEV_RUNNER" ]] || fail "Missing service runner: $DEV_RUNNER"
  printf '[ongi-herdr] Starting %s in pane %s...\n' "$label" "$pane_id"
  herdr pane run "$pane_id" "bash scripts/herdr/run-dev-service $service" >/dev/null || \
    fail "$label launch failed: Herdr could not submit the command to pane $pane_id."
  wait_for_url "$label" "$url"
}

stop_dev_service() {
  local service="$1"
  local label="$2"
  local pane_id="$3"
  local pid attempt

  if ! pid="$(managed_service_pid "$service" "$pane_id")"; then
    printf '[ongi-herdr] %s is not managed by this automation; left unchanged.\n' "$label"
    return
  fi

  printf '[ongi-herdr] Stopping %s (pid %s)...\n' "$label" "$pid"
  herdr pane send-keys "$pane_id" ctrl+c >/dev/null || \
    fail "$label stop failed: Herdr could not send Ctrl-C to pane $pane_id."
  for attempt in {1..15}; do
    kill -0 "$pid" 2>/dev/null || {
      printf '[ongi-herdr] %s stopped\n' "$label"
      return
    }
    sleep 1
  done
  fail "$label did not stop after Ctrl-C. Inspect pane $pane_id; no forced kill was attempted."
}

dev() {
  require_herdr_context
  require_command herdr
  require_command jq
  require_command codex
  require_command curl
  require_command npm
  [[ -x "$PROJECT_ROOT/backend/gradlew" ]] || fail "Backend Gradle wrapper is missing or not executable."
  [[ -d "$PROJECT_ROOT/node_modules" ]] || fail "Frontend dependencies are missing. Run npm install first."

  dev_layout
  setup
  ensure_database
  ensure_implementer
  herdr pane run "$GIT_PANE_ID" "git status --short --branch" >/dev/null || \
    fail "Git status step failed in pane $GIT_PANE_ID."
  start_dev_service frontend "Frontend" "$FRONTEND_PANE_ID" "$FRONTEND_URL"
  start_dev_service backend "Backend" "$BACKEND_PANE_ID" "$BACKEND_HEALTH_URL"

  printf '[ongi-herdr] Development environment ready\n'
  printf '  implementer: %s (%s)\n' "$IMPLEMENTER_TARGET" "$IMPLEMENT_PANE_ID"
  printf '  reviewer:    %s (%s)\n' "$REVIEWER_TARGET" "$REVIEW_PANE_ID"
  printf '  frontend:    %s\n' "$FRONTEND_URL"
  printf '  backend:     %s\n' "$BACKEND_HEALTH_URL"
}

stop_dev() {
  require_herdr_context
  require_command herdr
  require_command jq
  dev_layout >/dev/null
  stop_dev_service frontend "Frontend" "$FRONTEND_PANE_ID"
  stop_dev_service backend "Backend" "$BACKEND_PANE_ID"
  printf '[ongi-herdr] Managed dev servers stopped. PostgreSQL and Codex sessions were preserved.\n'
}

doctor() {
  require_command herdr
  require_command jq
  require_command codex
  require_command curl
  require_command npm
  require_command docker
  require_command java
  docker compose version >/dev/null 2>&1 || fail "Docker Compose is unavailable."
  [[ -x "$PROJECT_ROOT/backend/gradlew" ]] || fail "Backend Gradle wrapper is missing or not executable."
  printf '[ongi-herdr] prerequisites OK\n'
  printf '  Herdr: %s\n' "$(herdr --version)"
  printf '  jq:    %s\n' "$(jq --version)"
  printf '  Codex: %s\n' "$(codex --version 2>/dev/null || printf 'installed')"
  printf '  Node:  %s\n' "$(node --version)"
  printf '  Java:  %s\n' "$(java -version 2>&1 | head -n 1)"
  printf '  Docker Compose: %s\n' "$(docker compose version --short)"
  if [[ -d "$PROJECT_ROOT/node_modules" ]]; then
    printf '  Frontend dependencies: installed\n'
  else
    printf '  Frontend dependencies: missing (run npm install)\n'
  fi
  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      printf '  GitHub CLI: %s (authenticated)\n' "$(gh --version | head -n 1)"
    else
      printf '  GitHub CLI: %s (authentication required; ship will use URL fallback)\n' "$(gh --version | head -n 1)"
    fi
  else
    printf '  GitHub CLI: not installed (ship will use URL fallback)\n'
  fi
  if [[ "${HERDR_ENV:-}" == "1" ]]; then
    printf '  Herdr context: workspace=%s tab=%s pane=%s\n' \
      "${HERDR_WORKSPACE_ID:-unknown}" "${HERDR_TAB_ID:-unknown}" "${HERDR_PANE_ID:-unknown}"
  else
    printf '  Herdr context: not currently inside a Herdr pane\n'
  fi
}

main() {
  local command="${1:-help}"
  local profile run_id

  case "$command" in
    doctor)
      doctor
      ;;
    setup)
      setup
      ;;
    dev)
      dev
      ;;
    stop)
      stop_dev
      ;;
    restart)
      stop_dev
      dev
      ;;
    review)
      setup
      run_review
      ;;
    test)
      setup
      profile="${2:-}"
      [[ -n "$profile" ]] || profile="$(choose_profile)"
      run_id="$(date +%Y%m%d-%H%M%S)-$$"
      start_tests "$profile" "$run_id"
      printf 'Run `scripts/herdr/ongi-herdr results` when it finishes.\n'
      ;;
    all)
      run_all "${2:-verify}"
      ;;
    ship)
      ship "$@"
      ;;
    deploy-status)
      show_deploy_status
      ;;
    status)
      show_status
      ;;
    results)
      show_results
      ;;
    dev-layout)
      dev_layout
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      fail "Unknown command: $command"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
